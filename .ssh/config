# Per-machine hosts and keys go in ~/.ssh/config.local (untracked) it is read first
# run "chmod 700 ~/.ssh; mkdir -p ~/.ssh/cm" first
Include ~/.ssh/config.local

Host *
    #HashKnownHosts yes
    ServerAliveInterval 60
    AddKeysToAgent yes
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 10m
