Xft.dpi: 96
Xft.antialias: true
Xft.rgba: rgb
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.autohint: false
Xft.lcdfilter: lcddefault

*foreground: #ebdbb2
*background: #1d2021
*cursorColor: #ebdbb2
*highlightColor: #504945
*highlightTextColor: #fbf1c7
*color0: #282828
*color1: #cc241d
*color2: #98971a
*color3: #d79921
*color4: #458588
*color5: #b16286
*color6: #689d6a
*color7: #a89984
*color8: #928374
*color9: #fb4934
*color10: #b8bb26
*color11: #fabd2f
*color12: #83a598
*color13: #d3869b
*color14: #8ec07c
*color15: #ebdbb2

!! xterm
XTerm.termName: xterm-256color
XTerm.vt100.utf8: true
XTerm.vt100.metaSendsEscape: true
XTerm.vt100.backarrowKey: false
XTerm.ttyModes: erase ^?
XTerm.vt100.saveLines: 4096

XTerm.vt100.scrollBar: true
XTerm.vt100.scrollbar.width: 8
XTerm.vt100.alternateScroll: true

XTerm.vt100.colorBDMode: true
XTerm.vt100.colorBD: #fabd2f
XTerm.vt100.colorULMode: true
XTerm.vt100.colorUL: #83a598

XTerm.vt100.faceName: monospace:size=14:antialias=true
XTerm.vt100.boldFont: monospace:bold:size=14
XTerm.vt100.faceNameDoublesize: unifont

XTerm.vt100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

XTerm.vt100.bellIsUrgent: true

!! rxvt-unicode
URxvt.termName: rxvt-unicode-256color
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.locale: true
URxvt.inputMethod: fcitx
URxvt.imLocale: zh_CN.UTF-8
URxvt.preeditType: Root
! URxvt.imFont: ...
URxvt.font: xft:monospace:pixelsize=14, xft:Symbols Nerd Font Mono:pixelsize=14, xft:JuliaMono:pixelsize=14, xft:fairfaxhd:pixelsize=14, xft:unifont:pixelsize=14
URxvt.boldFont: xft:monospace:style=Bold:pixelsize=14, xft:JuliaMono:style=Bold:pixelsize=14, xft:fairfaxhd:pixelsize=14, xft:unifont:pixelsize=14
URxvt.italicFont: xft:monospace:style=Italic:pixelsize=14, xft:JuliaMono:style=Italic:pixelsize=14, xft:fairfaxhd:pixelsize=14, xft:unifont:pixelsize=14
URxvt.boldItalicFont: xft:monospace:style=Bold Italic:pixelsize=14, xft:JuliaMono:style=Bold Italic:pixelsize=14, xft:fairfaxhd:pixelsize=14, xft:unifont:pixelsize=14
URxvt.letterSpace: 0
URxvt.lineSpace: 1

! borders and scrollback
URxvt.internalBorder: 8
URxvt.externalBorder: 2
URxvt.saveLines: 16384
URxvt.scrollTtyOutput: false
URxvt.scrollWithBuffer: true
URxvt.scrollTtyKeypress: true
URxvt.secondaryScroll: false
URxvt.scrollstyle: rxvt
! Remove this line if you want printing/export support.
URxvt.print-pipe: cat > /dev/null

! Perl extensions
URxvt.perl-ext-common: default,eval,matcher,tabbed,readline,confirm-paste,selection-to-clipboard,searchable-scrollback

! URL matcher
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.pattern.1: \\bhttps?://[\\w\\-@;/?&=%.:#~+,]+[\\w\\-@/?&=%#~+]
URxvt.matcher.button: 1
URxvt.matcher.rend.0: Uline Bold fg4
URxvt.keysym.C-Delete: perl:matcher:last
URxvt.keysym.M-Delete: perl:matcher:list

! clipboard
URxvt.keysym.C-S-c: eval:selection_to_clipboard
URxvt.keysym.C-S-v: eval:paste_clipboard
URxvt.keysym.C-Insert: eval:selection_to_clipboard
URxvt.keysym.S-Insert: eval:paste_clipboard

! scrollback navigation
URxvt.keysym.M-Up: eval:scroll_up 1
URxvt.keysym.M-Down: eval:scroll_down 1
URxvt.keysym.M-Home: eval:scroll_to_top
URxvt.keysym.M-End: eval:scroll_to_bottom
