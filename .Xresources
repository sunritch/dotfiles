! xterm

XTerm*termName: xterm-256color

XTerm*foreground: #d5c4a1
XTerm*background: #282828
XTerm*cursorColor: #d5c4a1
XTerm*color0: #282828
XTerm*color1: #fb4934
XTerm*color2: #b8bb26
XTerm*color3: #fabd2f
XTerm*color4: #83a598
XTerm*color5: #d3869b
XTerm*color6: #8ec07c
XTerm*color7: #d5c4a1
XTerm*color8: #665c54
XTerm*color9: #fb4934
XTerm*color10: #b8bb26
XTerm*color11: #fabd2f
XTerm*color12: #83a598
XTerm*color13: #d3869b
XTerm*color14: #8ec07c
XTerm*color15: #fbf1c7

XTerm*faceName: unifont
XTerm*faceSize: 14
XTerm*renderFont: true
XTerm*utf8: 1
XTerm*locale: true

XTerm*saveLinks: 5000
XTerm*internalBorder: 8
!XTerm*scrollBar: false
XTerm*metaSendsEscape: true

XTerm*scrollTtyOutput: false
XTerm*scrollKey: true

XTerm*selectToClipboard: true

! urxvt
URxvt*depth: 32
URxvt*termName: rxvt-unicode

URxvt*pointerShape: xterm

URxvt*foreground: #d5c4a1
URxvt*background: #282828
URxvt*cursorColor: #d5c4a1
URxvt*color0: #282828
URxvt*color1: #fb4934
URxvt*color2: #b8bb26
URxvt*color3: #fabd2f
URxvt*color4: #83a598
URxvt*color5: #d3869b
URxvt*color6: #8ec07c
URxvt*color7: #d5c4a1
URxvt*color8: #665c54
URxvt*color9: #fb4934
URxvt*color10: #b8bb26
URxvt*color11: #fabd2f
URxvt*color12: #83a598
URxvt*color13: #d3869b
URxvt*color14: #8ec07c
URxvt*color15: #fbf1c7

URxvt*font: xft:unifont:pixelsize=16

!URxvt*boldFont: xft:dejavu sans mono:style=Bold:pixelsize=14
!URxvt*italicFont: xft:dejavu sans mono:style=Italic:pixelsize=14
!URxvt*boldItalicFont: xft:dejavu sans mono:style=Bold Italic:pixelsize=14

URxvt*internalBorder: 10
URxvt*externalBorder: 2
URxvt*saveLines: 5000

URxvt*scrollTtyOutput: false
URxvt*scrollWithBuffer: true
URxvt*scrollTtyKeypress: true

!URxvt*transparent: true
!URxvt*shading: 20

URxvt*selectToClipboard: true