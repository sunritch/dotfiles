Config
    { overrideRedirect = False
    , font     = "xft:monospace-10"
    , bgColor  = "#5f5f5f"
    , fgColor  = "#f8f8f2"
    , position = TopW L 90

    , commands =
        [ Run Weather "ZBAA"
            [ "--template", "<weather> <tempC>°C"
            , "-L", "0"
            , "-H", "25"
            , "--low",    "lightblue"
            , "--normal", "#f8f8f2"
            , "--high",   "red"
            ] 36000

        , Run Battery
            [ "-t", "<left>% "
            , "-L", "25"
            , "-H", "75"
            , "--high", "green"
            , "--normal", "yellow"
            , "--low", "red"
            ] 10

        , Run Wireless "wlan0"
            [ "--template", "<ssid> <quality>"
            , "-L", "20"
            , "-H", "60"
            , "--high", "green"
            , "--normal", "yellow"
            , "--low", "red"
            ] 10

        , Run Cpu
            [ "-L", "3"
            , "-H", "50"
            , "--high",   "red"
            , "--normal", "green"
            ] 10

        , Run Com "sh"
            [ "-c"
            , "if command -v wpctl >/dev/null 2>&1; then wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '/MUTED/ {print \"Vol: muted\"; exit} {printf \"Vol: %.0f%%\\n\", $2*100}'; elif command -v pactl >/dev/null 2>&1; then pactl get-sink-volume @DEFAULT_SINK@ | awk 'NR==1 {if (match($0, /[0-9]+%/)) print \"Vol: \" substr($0, RSTART, RLENGTH)}'; elif command -v amixer >/dev/null 2>&1; then amixer get Master | awk '/\\[[0-9]+%\\]/ {if (match($0, /\\[[0-9]+%\\]/)) {print \"Vol: \" substr($0, RSTART+1, RLENGTH-2); exit}}'; else echo 'Vol: N/A'; fi"
            ] "volume" 10

        , Run Memory
            ["--template", "Mem: <usedratio>%"] 10

        , Run Swap [] 10

        , Run Date
            "%a %Y-%m-%d <fc=#8be9fd>%H:%M</fc>"
            "date" 10

        , Run XMonadLog
        ]

    , sepChar  = "%"
    , alignSep = "}{"

    , template =
        "%XMonadLog% }{ %wlan0wi% | %volume% | %battery% | %cpu% | %memory% * %swap% | %ZBAA% | %date% "
    }
