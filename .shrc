# minimal POSIX interactive configuration
case $- in
    *i*) ;;
    *) return ;;
esac

if [ "$(id -u)" = 0 ]; then return; fi

# environment normally comes from ~/.profile; detect it now if this shell never saw it
if [ -z "${DOTFILES_ENV+x}" ] && [ -r "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi

HOSTNAME=$(uname -n)
PS1='$ '
if [ -n "${SSH_CONNECTION-}" ]; then PS1='${HOSTNAME%%.*}:'$PS1; fi
case ${DOTFILES_ENV-} in
    prod) PS1="PROD $PS1" ;;
    staging) PS1="STG $PS1" ;;
esac
